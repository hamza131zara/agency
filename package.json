{
  "name": "agency-portfolio-phase-one",
  "version": "1.0.0",
  "private": true,
  "description": "Public portfolio, services and project inquiry website for a software and AI agency.",
  "scripts": {
    "preview": "node scripts/preview-server.mjs",
    "test:preview": "node --test tests/preview-server.test.mjs",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.cjs",
    "test:responsive": "playwright test tests/e2e/responsive.spec.cjs",
    "automation:build": "tsc -p automation-runtime/tsconfig.json",
    "automation:migrate": "npm run automation:build && node automation-runtime/dist/src/migrate.js",
    "automation:api": "npm run automation:build && node automation-runtime/dist/src/server.js",
    "automation:worker": "npm run automation:build && node automation-runtime/dist/src/worker.js",
    "test:automation": "npm run automation:build && node --test automation-runtime/dist/test/*.test.js",
    "automation:demo": "node automation-runtime/scripts/send-synthetic.mjs",
    "automation:operator-hash": "node automation-runtime/scripts/create-operator-password-hash.mjs",
    "build:netlify": "node scripts/build-netlify.mjs",
    "test:netlify-build": "node --test tests/netlify-build.test.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "type": "module",
  "dependencies": {
    "pg": "8.23.1"
  }
}
