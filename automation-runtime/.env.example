# Copy to your private runtime environment; never commit real values.
NODE_ENV=development
PORT=8787
DATABASE_URL=postgres://agency_automation:local-dev-only@127.0.0.1:5432/agency_automation
AUTOMATION_HMAC_KEYS={"local-dev":"replace-with-at-least-32-random-bytes"}
AUTOMATION_ALLOWED_SOURCES=agency-contact-form
AUTOMATION_MAX_BODY_BYTES=16384
AUTOMATION_SIGNATURE_TOLERANCE_SECONDS=300
AUTOMATION_RATE_LIMIT_PER_MINUTE=30
AUTOMATION_FAKE_TRANSPORT_MODE=success
AUTOMATION_WORKER_POLL_MS=1000
# Generate a scrypt hash with: npm run automation:operator-hash
AUTOMATION_OPERATOR_PASSWORD_HASH=replace-with-generated-salt-and-hash
